{
  "family": "taskjs-td",
  "networkMode": "bridge",
  "containerDefinitions": [
    {
      "name": "taskjs-container",
      "image": "<IMAGE_URI>",
      "essential": true,
      "cpu": 512,
      "memory": 350,
      "portMappings": [
        {
          "name": "taskjs-container-3333-tcp",
          "containerPort": 3333,
          "protocol": "tcp"
        }
      ]
    }
  ],
  "executionRoleArn": "arn:aws:iam::905418022082:role/ecsTaskExecutionRole",
  "compatibilities": ["EC2"],
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "requiresCompatibilities": ["EC2"],
  "cpu": 512,
  "memory": 400
}
