{
  "family": "taskjs-td",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "taskjs-container",
      "image": "<IMAGE_URI>",
      "cpu": 256,
      "memory": 512,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3333,
          "hostPort": 3333
        }
      ]
    }
  ]
}
