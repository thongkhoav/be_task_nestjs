{
  "family": "taskjs-td",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "taskjs-container",
      "image": "<IMAGE_URI>",
      "essential": true,
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 3333,
          "protocol": "tcp"
        }
      ]
    }
  ],
  "compatibilities": ["EC2"],
  "requiresCompatibilities": ["EC2"],
  "cpu": "512",
  "memory": "512"
}
