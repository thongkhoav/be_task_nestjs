PORT=3333 # Backend HTTP and WebSocket port

DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=123456
DB_PORT=5432
DB_DATABASE=task_js

ACCESS_TOKEN_SECRET=TO_ADD
ACCESS_TOKEN_DURATION=TO_ADD # e.g 30s, 15m, 2h, 7d
REFRESH_TOKEN_SECRET=TO_ADD
REFRESH_TOKEN_DURATION=TO_ADD # e.g 30s, 15m, 2h, 7d
COOKIE_DURATION=604800 # 7 days in seconds
COOKIE_SAME_SITE=lax
# COOKIE_SECURE=true # Optional development override; production is always Secure
# COOKIE_DOMAIN=.example.com # Optional shared parent domain for API and frontend
JWT_RESET_SECRET=TO_ADD # Secret for JWT reset password token
JWT_RESET_DURATION=TO_ADD # 15m

COOKIE_AUTH=TO_ADD # e.g TaskApp_Tokens, this is the name of the cookie used for authentication
FE_HOST=http://localhost:3000 # Single frontend host used for links such as password reset
FE_ORIGINS=http://localhost:3000 # Comma-separated origins allowed by HTTP and WebSocket CORS

INVITE_PREFIX=TO_ADD # e.g task_app/invite

FIREBASE_PROJECT_ID=TO_ADD # get from Firebase console
FIREBASE_CLIENT_EMAIL=TO_ADD # get from Firebase console
FIREBASE_PRIVATE_KEY=TO_ADD # get from Firebase console

REDIS_HOST=localhost # Redis server host, usually localhost or the IP address of your Redis server
REDIS_PORT=6379

Cookie_HttpOnly=false # Set to true in production for security
Cookie_Secure=false # Set to true in production for security

GMAIL_APP_PASS=TO_ADD # Gmail app password for sending emails
GMAIL_USER=TO_ADD # Gmail user for sending emails
EMAIL_SERVICE=gmail # Email service provider, e.g., gmail, outlook, etc.
EMAIL_HOST=smtp.gmail.com # SMTP host for the email service
EMAIL_PORT=465 # SMTP port for the email service
EMAIL_SECURE=true # Use secure connection for the email service
